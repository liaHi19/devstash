# Neon Postgres pooled connection string for the development branch.
# Format: postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL=

# Optional override for the user-facing brand (defaults to "DevStash").
NEXT_PUBLIC_APP_NAME=

# NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app credentials (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend API key (https://resend.com) for transactional email
RESEND_API_KEY=

# Verified sender for verification emails (e.g. "DevStash <noreply@yourdomain.com>")
RESEND_FROM_EMAIL=

# Public app URL used to build verification links (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Dev-only: set to "true" to auto-verify new users and bypass the sign-in gate.
# Use until a verified Resend sender domain is configured.
SKIP_EMAIL_VERIFICATION=
